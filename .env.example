APP_NAME=GaonOne API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

POSTGRES_DB=gaonone
POSTGRES_USER=gaonone
POSTGRES_PASSWORD=gaonone_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://gaonone:gaonone_dev_password@db:5432/gaonone

REDIS_URL=redis://redis:6379/0

SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
