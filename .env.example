APP_NAME=GaonOne API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
APP_VERSION=0.4.0

POSTGRES_DB=gaonone
POSTGRES_USER=gaonone
POSTGRES_PASSWORD=gaonone_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://gaonone:gaonone_dev_password@db:5432/gaonone

REDIS_URL=redis://redis:6379/0

# Generate a strong random secret before staging/production.
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Public/media storage. Production should use the deployed HTTPS base URL.
PUBLIC_BASE_URL=http://localhost:8000
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=8

# OTP / SMS
DEV_OTP=123456
OTP_TTL_SECONDS=300
OTP_RATE_WINDOW_SECONDS=900
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_MAX_VERIFY_ATTEMPTS=6
SMS_PROVIDER=none

# Payments (leave empty until Razorpay credentials are available)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Push notifications (leave empty until Firebase project is connected)
FCM_PROJECT_ID=

# Location/map provider abstraction. GPS/radius search works without a map key.
MAPS_PROVIDER=none
MAPS_API_KEY=
