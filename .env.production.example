APP_NAME=GaonOne API
APP_ENV=production
APP_DEBUG=false
API_V1_PREFIX=/api/v1
APP_VERSION=0.4.0

DOMAIN=example.com
ACME_EMAIL=admin@example.com
PUBLIC_BASE_URL=https://example.com
CORS_ORIGINS=https://example.com
TRUSTED_HOSTS=example.com

POSTGRES_DB=gaonone
POSTGRES_USER=gaonone
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://gaonone:REPLACE_WITH_STRONG_DATABASE_PASSWORD@db:5432/gaonone
REDIS_URL=redis://redis:6379/0

SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=8

# Authentication. Production pilot uses the MSG91 OTP Widget.
AUTH_PROVIDER=msg91_widget
DEV_OTP=
OTP_TTL_SECONDS=300
OTP_RATE_WINDOW_SECONDS=900
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_MAX_VERIFY_ATTEMPTS=6
SMS_PROVIDER=none
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_WIDGET_AUTH_KEY=REPLACE_WITH_PRIVATE_WIDGET_AUTH_KEY
SMS_HTTP_TIMEOUT_SECONDS=8

# Public widget values are embedded in the web build. The widget token is designed
# for client-side Widget SDK use; never use MSG91_WIDGET_AUTH_KEY in the frontend.
NEXT_PUBLIC_MSG91_WIDGET_ID=REPLACE_WITH_WIDGET_ID
NEXT_PUBLIC_MSG91_WIDGET_TOKEN=REPLACE_WITH_WIDGET_TOKEN

# One-time production pilot bootstrap. Fill these before `make prod-bootstrap`.
PILOT_ADMIN_PHONE=
PILOT_ADMIN_NAME=
PILOT_DELIVERY_PHONE=
PILOT_DELIVERY_NAME=GaonOne Pilot Rider
PILOT_VILLAGE_NAME=
PILOT_VILLAGE_TALUKA=
PILOT_VILLAGE_DISTRICT=
PILOT_VILLAGE_STATE=Maharashtra
PILOT_VILLAGE_PINCODE=
PILOT_VILLAGE_LATITUDE=
PILOT_VILLAGE_LONGITUDE=
PILOT_CLUSTER_NAME=GaonOne Pilot Cluster
PILOT_RADIUS_KM=12

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
FCM_PROJECT_ID=
MAPS_PROVIDER=none
MAPS_API_KEY=
