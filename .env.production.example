APP_NAME=GaonOne API
APP_ENV=production
APP_DEBUG=false
API_V1_PREFIX=/api/v1
APP_VERSION=0.5.0
DOMAIN=example.com
ACME_EMAIL=admin@example.com
PUBLIC_BASE_URL=https://example.com
CORS_ORIGINS=https://example.com
TRUSTED_HOSTS=example.com
POSTGRES_DB=gaonone
POSTGRES_USER=gaonone
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://gaonone:REPLACE_WITH_STRONG_DATABASE_PASSWORD@db:5432/gaonone
REDIS_URL=redis://redis:6379/0
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=8
AUTH_PROVIDER=msg91_widget
MSG91_AUTH_KEY=REPLACE_WITH_PRIVATE_OTPAUTH_KEY
DEV_OTP=
OTP_TTL_SECONDS=300
OTP_RATE_WINDOW_SECONDS=900
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_MAX_VERIFY_ATTEMPTS=6
SMS_PROVIDER=none
MSG91_TEMPLATE_ID=
SMS_HTTP_TIMEOUT_SECONDS=8
PILOT_ADMIN_PHONE=
PILOT_ADMIN_NAME=
PILOT_DELIVERY_PHONE=
PILOT_DELIVERY_NAME=GaonOne Pilot Rider
PILOT_VILLAGE_NAME=
PILOT_VILLAGE_TALUKA=
PILOT_VILLAGE_DISTRICT=
PILOT_VILLAGE_STATE=Maharashtra
PILOT_VILLAGE_PINCODE=
PILOT_VILLAGE_LATITUDE=
PILOT_VILLAGE_LONGITUDE=
PILOT_CLUSTER_NAME=GaonOne Pilot Cluster
PILOT_RADIUS_KM=12
# Razorpay intentionally stays disabled until activation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# FCM: keep both blank until Firebase project setup. Store the service-account JSON as one base64 string; never commit it.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_B64=
MAPS_PROVIDER=none
MAPS_API_KEY=
