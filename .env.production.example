APP_NAME=GaonOne API
APP_ENV=production
APP_DEBUG=false
API_V1_PREFIX=/api/v1
APP_VERSION=0.4.0

DOMAIN=example.com
ACME_EMAIL=admin@example.com
PUBLIC_BASE_URL=https://example.com
CORS_ORIGINS=https://example.com
TRUSTED_HOSTS=example.com

POSTGRES_DB=gaonone
POSTGRES_USER=gaonone
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://gaonone:REPLACE_WITH_STRONG_DATABASE_PASSWORD@db:5432/gaonone
REDIS_URL=redis://redis:6379/0

SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=8

DEV_OTP=
OTP_TTL_SECONDS=300
OTP_RATE_WINDOW_SECONDS=900
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_MAX_VERIFY_ATTEMPTS=6
SMS_PROVIDER=none

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
FCM_PROJECT_ID=
MAPS_PROVIDER=none
MAPS_API_KEY=
